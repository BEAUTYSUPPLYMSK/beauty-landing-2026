# ============================================================
# BEAUTYSUPPLYMSK channel bot — environment variables
# Copy this file to `.env` for local runs, or set these values
# in the Railway dashboard (Variables tab) for production.
# ============================================================

# Telegram bot token from @BotFather (required).
# Example: 1234567890:AAExampleTokenFromBotFather
BOT_TOKEN=

# The channel the bot posts to (required).
# Either the numeric ID (recommended, looks like -1001234567890)
# or the public @username of the channel.
# Tip: forward any post from the channel to the bot and it will
# reply with the channel ID (/id also shows the current chat ID).
CHANNEL_ID=

# Comma-separated Telegram user IDs of the store admins (required).
# Only these users can manage content. Example: 111111111,222222222
# Get your own ID by sending /id to the bot (or use @userinfobot).
ADMIN_IDS=

# Database connection string (required in production).
# On Railway this is provided by the PostgreSQL plugin — set it to
# ${{Postgres.DATABASE_URL}} (a variable reference).
# If left empty, the bot falls back to a local SQLite file
# (sqlite+aiosqlite:///bot.db) — fine for local testing only.
DATABASE_URL=

# IANA timezone used for scheduling and displaying dates (optional).
# Default: Europe/Moscow
TIMEZONE=Europe/Moscow

# How the bot receives updates: "polling" (default) or "webhook".
# Polling needs no public URL and is the recommended mode on Railway.
RUN_MODE=polling

# Public HTTPS base URL of the deployment. ONLY used when
# RUN_MODE=webhook. Example: https://your-app.up.railway.app
WEBHOOK_URL=

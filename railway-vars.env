# ============================================================================
# BEAUTYSUPPLYMSK bot — готовый список переменных для импорта в Railway.
#
# КАК ИСПОЛЬЗОВАТЬ:
#   Railway Dashboard → сервис бота → вкладка «Variables» →
#   «Import Variables» → вставьте СОДЕРЖИМОЕ этого файла целиком.
#   Имена переменных появятся сразу; останется только вписать значения
#   (см. ниже). Секретов здесь нет — только имена и пустые значения.
#
# ВАЖНО: Railway НЕ читает .env.example из репозитория — переменные нужно
# импортировать вручную именно через этот файл или добавлять по одной.
# ============================================================================

# --- Обязательные переменные (вписать значения после «=») -----------------

# Токен бота от @BotFather (обязательно). Вставьте его без кавычек.
BOT_TOKEN=

# Канал, куда бот публикует посты (обязательно).
# Числовой ID (например -1001234567890) или @username канала.
CHANNEL_ID=

# Числовые ID администраторов через запятую (обязательно), например 111111111,222222222.
# Свой ID можно узнать командой /id у бота.
ADMIN_IDS=

# Строка подключения к базе данных. ОСТАВЬТЕ КАК ЕСТЬ — это ссылка на
# переменную сервиса Postgres (добавляется в Railway как «Database → PostgreSQL»).
# Если после импорта значение сохранилось буквально как текст
# ${{Postgres.DATABASE_URL}} — откройте значение и выберите
# «Variable Reference → Postgres.DATABASE_URL».
DATABASE_URL=${{Postgres.DATABASE_URL}}

# --- Необязательные переменные (уже заполнены значениями по умолчанию) ----

# Часовой пояс (IANA). По умолчанию Europe/Moscow.
TIMEZONE=Europe/Moscow

# Режим получения обновлений: polling (по умолчанию) или webhook.
# Для polling НЕ нужен публичный URL и НЕ настраивайте health check в Railway.
RUN_MODE=polling

# --- Только для webhook-режима (RUN_MODE=webhook) -------------------------
# Эти три переменные используются ИСКЛЮЧИТЕЛЬНО при RUN_MODE=webhook.
# При polling их можно не создавать вовсе.

# Публичный HTTPS-адрес деплоя, например https://your-app.up.railway.app
# (Railway: Settings → Networking → Generate Domain).
WEBHOOK_URL=

# Секретный токен, который Telegram шлёт с каждым webhook-запросом.
# Если задать здесь — тот же самый токен нужно указать в настройках бота
# у @BotFather (/setwebhook). Для polling не нужен.
WEBHOOK_SECRET=

# Порт, на котором приложение слушает webhook-запросы.
# Railway подставляет PORT автоматически; локально по умолчанию 8080.
PORT=8080
